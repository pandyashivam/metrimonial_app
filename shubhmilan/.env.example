# === Shared across the monorepo ===
NODE_ENV=development

# === Backend API (server/api) ===
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# Database (MySQL 8 via Docker compose)
DATABASE_URL="mysql://shubhmilan:shubhmilan@localhost:3306/shubhmilan"

# Redis (session/cache/queues)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-another-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# AES-256 encryption key for PII columns (base64, 32 bytes)
PII_ENCRYPTION_KEY="Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4MDA="

# Cloudflare R2 (S3-compatible) — using MinIO locally
R2_ENDPOINT="http://localhost:9000"
R2_REGION="auto"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="shubhmilan-photos"
R2_PUBLIC_URL="http://localhost:9000/shubhmilan-photos"

# SMS providers — priority: MSG91 → Twilio → dev console. Leave blank for dev.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SHBMLN"
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Email (SMTP). Leave blank for dev console fallback.
EMAIL_FROM="noreply@shubhmilan.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Razorpay (test keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OpenAI (leave empty for no-op fallback; features degrade gracefully)
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Expo Push (optional access token; works without it but rate-limited)
EXPO_ACCESS_TOKEN=""

# Third-party KYC providers. Dev: prefix providerRef with "dev-" to bypass.
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""
DIGIO_BASE_URL="https://ext.digio.in:444"
HYPERVERGE_APP_ID=""
HYPERVERGE_APP_KEY=""

# === Mobile (apps/mobile) ===
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:4000

# === Web (apps/web, apps/admin) ===
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
