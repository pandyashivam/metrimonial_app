# =============================================================================
# ShubhMilan environment template — copy to `.env` (root and/or per-package)
# Required = the app fails to boot without it.
# Optional = leave blank in dev; the related feature is a no-op until set.
# =============================================================================

# Shared
NODE_ENV=development


# === Backend API (server/api) =================================================

# REQUIRED: server bind
API_PORT=4000
API_HOST=0.0.0.0

# REQUIRED: CORS allowlist for the web build of the app + admin dashboard
WEB_PUBLIC_URL=http://localhost:8081
ADMIN_PUBLIC_URL=http://localhost:3001

# REQUIRED: MySQL (direct via Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shubhmilan
DB_USER=root
DB_PASS=

# REQUIRED: JWT signing for short-lived access tokens.
# Refresh tokens are stored as a SHA-256 hash in the DB — no JWT secret needed.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-32-plus-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# REQUIRED: AES-256 key for PII column encryption (32-byte base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY="Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4MDA="


# === Optional integrations ====================================================
# Each block is optional in dev; the feature degrades to a console / no-op
# fallback when the keys are blank.

# AWS S3 — photo + chat media storage (without these, uploads fail)
AWS_S3_REGION="ap-south-1"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="shubhmilan-photos"
AWS_S3_PUBLIC_URL=""

# SMS — provider priority MSG91 → Twilio → dev console (the latter logs OTPs).
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SHBMLN"
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Email (SMTP). Blank → falls back to console logging in dev.
EMAIL_FROM="noreply@shubhmilan.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Razorpay — payments. Blank → premium upgrade buttons return a stub order.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Google Gemini — AI matches + content moderation. Blank → features no-op.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Expo Push — native notifications. Optional access token, not required.
EXPO_ACCESS_TOKEN=""

# Web Push (VAPID) — browser notifications. Generate with:
#   npx web-push generate-vapid-keys
# Public key must match EXPO_PUBLIC_VAPID_PUBLIC_KEY in apps/mobile/.env.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@shubhmilan.local"

# Aadhaar / KYC providers. In dev, prefix providerRef with "dev-" to bypass.
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""
DIGIO_BASE_URL="https://ext.digio.in:444"
HYPERVERGE_APP_ID=""
HYPERVERGE_APP_KEY=""


# === Mobile app (apps/mobile) =================================================
# Lives in apps/mobile/.env. The EXPO_PUBLIC_ prefix exposes it to the bundle.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:4000
# Same as VAPID_PUBLIC_KEY above. Optional — without it, web push is skipped.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=""


# === Admin dashboard (apps/admin) =============================================
# Lives in apps/admin/.env. Only this one is read by the admin app.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
