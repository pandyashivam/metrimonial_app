# === Shared across the monorepo ===
NODE_ENV=development

# === Backend API (server/api) ===
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# Database (MySQL — direct connection via Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shubhmilan
DB_USER=root
DB_PASS=

# JWT
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-another-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# AES-256 encryption key for PII columns (base64, 32 bytes)
PII_ENCRYPTION_KEY="Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4Zm9vYmFyYmF6cXV4MDA="

# AWS S3 (photo & chat media storage)
AWS_S3_REGION="ap-south-1"
AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="shubhmilan-photos"
AWS_S3_PUBLIC_URL=""

# SMS providers — priority: MSG91 → Twilio → dev console. Leave blank for dev.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SHBMLN"
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Email (SMTP). Leave blank for dev console fallback.
EMAIL_FROM="noreply@shubhmilan.local"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Razorpay (test keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Google Gemini (leave empty for no-op fallback; features degrade gracefully)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Expo Push (optional access token; works without it but rate-limited)
EXPO_ACCESS_TOKEN=""

# Third-party KYC providers. Dev: prefix providerRef with "dev-" to bypass.
DIGIO_CLIENT_ID=""
DIGIO_CLIENT_SECRET=""
DIGIO_BASE_URL="https://ext.digio.in:444"
HYPERVERGE_APP_ID=""
HYPERVERGE_APP_KEY=""

# === Mobile (apps/mobile) ===
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:4000

# === Web (apps/web, apps/admin) ===
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
