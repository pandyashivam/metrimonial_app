// ShubhMilan — Prisma schema (MySQL 8)
// Source of truth for all database models. Generate client: `pnpm db:generate`.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================
//  Enums
// =========================

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
}

enum Diet {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  JAIN_VEGETARIAN
  VEGAN
}

enum YesNoOccasional {
  NO
  OCCASIONALLY
  YES
}

enum ManglikStatus {
  NO
  YES
  ANSHIK
  UNKNOWN
}

enum FamilyType {
  NUCLEAR
  JOINT
}

enum FamilyValues {
  TRADITIONAL
  MODERATE
  LIBERAL
}

enum PhotoPrivacy {
  PUBLIC
  MEMBERS
  REQUEST
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationTier {
  BASIC
  VERIFIED
  PREMIUM
}

enum InterestStatus {
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET
  VERIFY_EMAIL
  VERIFY_PHONE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

// =========================
//  Core
// =========================

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  phone            String      @unique
  passwordHash     String
  role             UserRole    @default(USER)
  status           UserStatus  @default(ACTIVE)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  profile          Profile?
  devices          Device[]
  subscriptions    Subscription[]
  refreshTokens    RefreshToken[]
  adminLogs        AdminLog[]
  notificationPref NotificationPref?
  authoredContent  Content[]
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Profile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String
  gender             Gender
  dob                DateTime
  height             String
  weight             Int?
  maritalStatus      MaritalStatus
  motherTongue       String
  religion           String
  caste              String
  subCaste           String?
  gotra              String?
  manglik            ManglikStatus @default(UNKNOWN)
  rashi              String?
  nakshatra          String?
  education          String
  occupation         String
  income             String?
  city               String
  state              String
  country            String        @default("India")
  diet               Diet
  smoking            YesNoOccasional @default(NO)
  drinking           YesNoOccasional @default(NO)
  aboutMe            String        @db.Text
  familyValues       FamilyValues  @default(MODERATE)
  personalityTraits  Json
  hobbies            Json
  languages          Json
  complexion         String?
  bodyType           String?

  // X25519 public key (base64) for end-to-end encrypted chat (nacl.box).
  // The matching private key never leaves the user's device (SecureStore).
  publicKey          String?       @db.VarChar(64)

  lastActiveAt       DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  family             Family?
  embedding          ProfileEmbedding?
  horoscope          Horoscope?
  preference         PartnerPreference?
  verification       Verification?
  photos             Photo[]

  interestsSent      Interest[]    @relation("InterestFrom")
  interestsReceived  Interest[]    @relation("InterestTo")
  shortlistedBy      Shortlist[]   @relation("SavedProfile")
  shortlistOwner     Shortlist[]   @relation("OwnerProfile")
  blocksMade         Block[]       @relation("Blocker")
  blocksReceived     Block[]       @relation("Blocked")
  reportsMade        Report[]      @relation("Reporter")
  reportsReceived    Report[]      @relation("Reported")

  conversationsA     Conversation[] @relation("ProfileA")
  conversationsB     Conversation[] @relation("ProfileB")
  messagesSent       Message[]      @relation("Sender")
  viewsMade          ProfileView[]  @relation("Viewer")
  viewsReceived      ProfileView[]  @relation("Viewed")
  matchScoresA       MatchScore[]   @relation("MatchA")
  matchScoresB       MatchScore[]   @relation("MatchB")

  @@index([gender, religion, city])
  @@index([caste, motherTongue])
  @@index([lastActiveAt])
}

model Family {
  id               String      @id @default(cuid())
  profileId        String      @unique
  profile          Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)

  fatherName       String
  fatherOccupation String?
  motherName       String
  motherOccupation String?
  siblings         Json
  familyType       FamilyType  @default(NUCLEAR)
  familyStatus     String?
  nativePlace      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Horoscope {
  id           String   @id @default(cuid())
  profileId    String   @unique
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  birthTime    String
  birthPlace   String
  charan       String?
  nadi         String?
  gana         String?
  yoni         String?
  doshas       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PartnerPreference {
  id             String   @id @default(cuid())
  profileId      String   @unique
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  ageMin         Int
  ageMax         Int
  heightMin      String?
  heightMax      String?
  religions      Json
  castes         Json
  motherTongues  Json
  education      Json
  occupation     Json
  incomeMin      String?
  cities         Json
  diet           Json
  manglik        ManglikStatus?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Photo {
  id                String           @id @default(cuid())
  profileId         String
  profile           Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  r2Key             String
  isPrimary         Boolean          @default(false)
  privacy           PhotoPrivacy     @default(MEMBERS)
  moderationStatus  ModerationStatus @default(PENDING)
  uploadedAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([profileId])
}

model Verification {
  id                  String            @id @default(cuid())
  profileId           String            @unique
  profile             Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  emailVerified       Boolean           @default(false)
  phoneVerified       Boolean           @default(false)
  aadhaarVerified     Boolean           @default(false)
  selfieVerified      Boolean           @default(false)
  videoKycVerified    Boolean           @default(false)
  backgroundVerified  Boolean           @default(false)
  aadhaarLast4Enc     String?           @db.Text
  trustScore          Int               @default(0)
  tier                VerificationTier  @default(BASIC)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// =========================
//  Interactions
// =========================

model Interest {
  id              String          @id @default(cuid())
  fromProfileId   String
  toProfileId     String
  status          InterestStatus  @default(SENT)
  note            String?         @db.Text
  sentAt          DateTime        @default(now())
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  fromProfile     Profile         @relation("InterestFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile       Profile         @relation("InterestTo", fields: [toProfileId], references: [id], onDelete: Cascade)

  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, status])
  @@index([fromProfileId, status])
}

model Shortlist {
  id               String   @id @default(cuid())
  ownerProfileId   String
  savedProfileId   String
  savedAt          DateTime @default(now())

  ownerProfile     Profile  @relation("OwnerProfile", fields: [ownerProfileId], references: [id], onDelete: Cascade)
  savedProfile     Profile  @relation("SavedProfile", fields: [savedProfileId], references: [id], onDelete: Cascade)

  @@unique([ownerProfileId, savedProfileId])
  @@index([ownerProfileId])
}

model Block {
  id               String   @id @default(cuid())
  blockerProfileId String
  blockedProfileId String
  reason           String?
  createdAt        DateTime @default(now())

  blocker          Profile  @relation("Blocker", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blocked          Profile  @relation("Blocked", fields: [blockedProfileId], references: [id], onDelete: Cascade)

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockedProfileId])
}

model Report {
  id                 String       @id @default(cuid())
  reporterProfileId  String
  reportedProfileId  String
  reason             String
  detail             String?      @db.Text
  status             ReportStatus @default(OPEN)
  resolvedByUserId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  reporter           Profile      @relation("Reporter", fields: [reporterProfileId], references: [id], onDelete: Cascade)
  reported           Profile      @relation("Reported", fields: [reportedProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reportedProfileId])
}

model ProfileView {
  id                String   @id @default(cuid())
  viewerProfileId   String
  viewedProfileId   String
  viewedAt          DateTime @default(now())

  viewer            Profile  @relation("Viewer", fields: [viewerProfileId], references: [id], onDelete: Cascade)
  viewed            Profile  @relation("Viewed", fields: [viewedProfileId], references: [id], onDelete: Cascade)

  @@index([viewedProfileId, viewedAt])
  @@index([viewerProfileId, viewedAt])
}

// =========================
//  Chat
// =========================

model Conversation {
  id              String    @id @default(cuid())
  profileAId      String
  profileBId      String
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profileA        Profile   @relation("ProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileB        Profile   @relation("ProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([profileAId, profileBId])
  @@index([profileAId, lastMessageAt])
  @@index([profileBId, lastMessageAt])
}

model Message {
  id                 String       @id @default(cuid())
  conversationId     String
  senderProfileId    String

  // End-to-end encrypted payload. `body` holds the base64-encoded ciphertext produced by
  // nacl.box(plaintext, nonce, peerPublicKey, senderSecretKey) on the sender's device.
  // The server never possesses plaintext.
  body               String       @db.Text
  nonce              String       @db.VarChar(40)
  encrypted          Boolean      @default(true)

  // Media (optional). The client uploads the file to R2 after encrypting it with a per-
  // message symmetric key; that key is included inside the encrypted body payload.
  mediaUrl           String?
  mediaMime          String?

  readAt             DateTime?
  createdAt          DateTime     @default(now())

  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             Profile      @relation("Sender", fields: [senderProfileId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderProfileId])
}

// =========================
//  Matching (cache)
// =========================

model MatchScore {
  id           String   @id @default(cuid())
  profileAId   String
  profileBId   String
  score        Int
  reasons      Json
  computedAt   DateTime @default(now())

  profileA     Profile  @relation("MatchA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileB     Profile  @relation("MatchB", fields: [profileBId], references: [id], onDelete: Cascade)

  @@unique([profileAId, profileBId])
  @@index([profileAId, score])
}

// =========================
//  Payments
// =========================

model Plan {
  id             String          @id @default(cuid())
  name           String
  priceInr       Int
  durationDays   Int
  features       Json
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  subscriptions  Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(PENDING)
  startsAt           DateTime           @default(now())
  endsAt             DateTime
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([razorpayOrderId])
}

// =========================
//  Auth / Notifications
// =========================

model Otp {
  id          String     @id @default(cuid())
  target      String
  codeHash    String
  purpose     OtpPurpose
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([target, purpose])
  @@index([expiresAt])
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  fcmToken    String   @unique
  platform    String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ContentKind {
  SUCCESS_STORY
  BLOG_POST
  EVENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// CMS-lite. One table covers every long-form asset we publish on the marketing site:
/// success stories, blog posts, events. Admins CRUD via /admin/content/*; the marketing
/// site reads via the public /content/* endpoints (no auth).
model Content {
  id          String        @id @default(cuid())
  kind        ContentKind
  slug        String
  title       String
  excerpt     String?       @db.Text
  body        String        @db.LongText
  coverKey    String?
  meta        Json?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  authorId    String?

  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([kind, slug])
  @@index([kind, status])
  @@index([publishedAt])
}

/// Per-user push preferences. Missing rows default to "all categories enabled" — users only
/// create a row when they opt out of something.
model NotificationPref {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  newInterest             Boolean  @default(true)
  interestAccepted        Boolean  @default(true)
  newMessage              Boolean  @default(true)
  profileViewed           Boolean  @default(true)
  premiumMatch            Boolean  @default(true)
  verificationApproved    Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Singleton-shaped key/value store for runtime-tunable feature flags (maintenance mode,
/// feature rollouts, email template overrides). Keys are unique; values are opaque JSON so
/// each consumer can validate with its own Zod schema.
model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      Json
  updatedAt  DateTime @updatedAt
  updatedBy  String?

  @@index([key])
}

model AdminLog {
  id           String   @id @default(cuid())
  adminUserId  String
  action       String
  targetType   String?
  targetId     String?
  meta         Json?
  createdAt    DateTime @default(now())

  admin        User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action])
}

// =========================
//  OpenAI embeddings (sidecar for semantic match rerank)
// =========================

model ProfileEmbedding {
  id          String   @id @default(cuid())
  profileId   String   @unique
  model       String   // e.g. "text-embedding-3-small"
  dimension   Int      // 1536 for small, 3072 for large
  vector      Bytes    // float32 array packed little-endian
  sourceHash  String   // sha256 of aboutMe; recompute when it changes
  computedAt  DateTime @default(now())

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([model])
}

// =========================
//  Match served log (A/B testing / online metrics)
// =========================

model MatchLog {
  id              String   @id @default(cuid())
  viewerProfileId String
  candidateId     String
  rank            Int
  score           Int
  variant         String   @default("v1")
  interacted      Boolean  @default(false)
  interactionKind String?
  createdAt       DateTime @default(now())

  @@index([viewerProfileId, createdAt])
  @@index([candidateId])
  @@index([variant])
}
