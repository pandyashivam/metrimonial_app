{
  "name": "@shubhmilan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"test/integration/**\"",
    "test:unit": "vitest run --exclude \"test/integration/**\"",
    "test:integration": "vitest run test/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "precompute:matches": "tsx src/jobs/precompute-matches.ts",
    "precompute:matches:prod": "node dist/jobs/precompute-matches.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@prisma/client": "^5.22.0",
    "@shubhmilan/types": "workspace:*",
    "@shubhmilan/validation": "workspace:*",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "@aws-sdk/client-s3": "^3.691.0",
    "@aws-sdk/s3-request-presigner": "^3.691.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.8",
    "nodemailer": "^6.9.16",
    "openai": "^4.73.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "razorpay": "^2.9.5",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@shubhmilan/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.16",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
